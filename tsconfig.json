{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2018"],
    "types": ["node"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "main.ts",
    "settings.ts",
    "models/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts",
    "ui/**/*.ts"
  ]
}

